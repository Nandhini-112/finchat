# Azure Functions Worker Runtime
FUNCTIONS_WORKER_RUNTIME=node
AzureWebJobsStorage=UseDevelopmentStorage=true
AzureWebJobsFeatureFlags=EnableWorkerIndexing

# Timer Trigger Configuration
DOCUMENT_QUEUE_CRON=0 */5 * * * *

# Azure SQL Database Configuration
AZURE_SQL_SERVER=your-sql-server.database.windows.net
AZURE_SQL_DATABASE=financial-chatbot
AZURE_SQL_USER=your-sql-username
AZURE_SQL_PASSWORD=your-sql-password
AZURE_SQL_ENCRYPT=true

# =========================================================================
# 1. LLM CONFIGURATION (VERSATILE: AZURE PRIMARY WITH OUTSIDE FALLBACK)
# =========================================================================

# Primary LLM: Azure OpenAI (Evaluated first when all 3 variables are configured)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_TIMEOUT_SECONDS=30

# Secondary / Fallback LLM: Outside Model (Groq, OpenAI, or OpenAI-compatible)
# Used automatically if Azure LLM is not configured, rate-limited (HTTP 429), or experiencing outages.
OUTSIDE_LLM_API_KEY=your-outside-or-groq-key
OUTSIDE_LLM_BASE_URL=https://api.groq.com/openai/v1
OUTSIDE_LLM_CHAT_MODEL=llama-3.3-70b-versatile
OUTSIDE_LLM_MAX_TOKENS=4096
OUTSIDE_LLM_TEMPERATURE=0.1
OUTSIDE_LLM_MAX_RETRIES=2
OUTSIDE_LLM_TIMEOUT_SECONDS=45

# Backward-compatible Groq aliases:
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.1
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT_SECONDS=60

# =========================================================================
# 2. EMBEDDING MODEL CONFIGURATION (SINGLE MODEL: AZURE OPENAI ONLY)
# Vectors must remain mathematically consistent across indexing and queries.
# =========================================================================
AZURE_EMBEDDING_ENDPOINT=https://your-openai-resource.services.ai.azure.com
AZURE_EMBEDDING_API_KEY=your-azure-openai-key
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_TIMEOUT_SECONDS=30

# Backward-compatible Azure embedding aliases:
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# =========================================================================
# 3. AZURE AI SEARCH & DOCUMENT INTELLIGENCE CONFIGURATION
# =========================================================================
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-api-key
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key
AZURE_SEARCH_INDEX=finance-hr-documents

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel-service.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-doc-intel-key

# Document Ingestion & Chunking Limits
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Microsoft Graph / SharePoint Queue Integration
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/YourSite
SHAREPOINT_QUEUE_LIST=DocumentIngestQueue_new
